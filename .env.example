NODE_ENV=development
API_PORT=3000
APP_DOMAIN=mediagnostics.example.com
APP_TIME_ZONE=America/Bogota
WEB_ORIGIN=http://localhost:5173

POSTGRES_DB=mediagnostics
POSTGRES_USER=mediagnostics
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://mediagnostics:replace-with-a-local-password@localhost:5432/mediagnostics

REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
PDF_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MS=60000

STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mediagnostics-local
STORAGE_ACCESS_KEY=replace-with-a-local-access-key
STORAGE_SECRET_KEY=replace-with-a-local-secret-key
STORAGE_FORCE_PATH_STYLE=true

INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_NAME="Mediagnostics Administrator"
INITIAL_ADMIN_PASSWORD=replace-with-at-least-15-characters
